color-link default "#e4e1e9"
color-link comment "#918f9a"
color-link selection "#e0e0ff,#3e4278"
color-link hlsearch "#c5c4dd"

color-link identifier "#bfc2ff"
color-link identifier.class "#bfc2ff"
color-link identifier.var "#bfc2ff"

color-link constant "#e8b9d5"
color-link constant.number "#e8b9d5"
color-link constant.string "#c5c4dd"

color-link symbol "#e8b9d5"
color-link symbol.brackets "#c7c5d0"
color-link symbol.tag "#bfc2ff"

color-link type "#bfc2ff"
color-link type.keyword "#c5c4dd"

color-link special "#e8b9d5"
color-link statement "#bfc2ff"
color-link preproc "#e8b9d5"

color-link underlined "#c5c4dd"
color-link error "bold #ffb4ab"
color-link todo "bold #e8b9d5"

color-link diff-added "#c5c4dd"
color-link diff-modified "#e8b9d5"
color-link diff-deleted "#ffb4ab"

color-link gutter-error "#ffb4ab"
color-link gutter-warning "#e8b9d5"

color-link scrollbar "#c7c5d0"
color-link statusline "#e4e1e9,#131318"
color-link tabbar "#e4e1e9,#131318"
color-link indent-char "#46464f"
color-link line-number "#918f9a"
color-link current-line-number "#bfc2ff"

color-link cursor-line "#e4e1e9,#2a292f"
color-link color-column "#46464f"
color-link type.extended "default"